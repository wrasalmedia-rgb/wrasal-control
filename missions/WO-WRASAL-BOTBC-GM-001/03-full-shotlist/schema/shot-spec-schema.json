{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WRASAL ShotSpec v1.0",
  "description": "Machine-readable shot specification — Required fields per Mission §9",
  "type": "object",
  "required": ["identifier","act","scene","time_period","timecode","duration_seconds","narrative_function","genre_state","subject","character_ids","prop_ids","camera","lens","framing","angle","movement","lighting","blocking","performance","dialogue","sound","editorial_transition_in","continuity","source_reference","assumptions","verification_status"],
  "properties": {
    "identifier": {"type":"string","pattern":"^SH[0-9]{3}$","description":"Traceable shot ID SH001-SH034 preserved from baseline"},
    "act": {"type":"string","enum":["I","I→II","II","III","IV","IV→I","—"],"description":"Act per genre engine"},
    "scene": {"type":"string","description":"Scene/location grouping"},
    "time_period": {"type":"string","enum":["1980s","2026","2026/1980s","GFX"],"description":"Diegetic period or GFX"},
    "timecode": {"type":"string","description":"Human readable timecode plus duration"},
    "timecode_in": {"type":"string","description":"Start timecode 00:MM:SS"},
    "timecode_out": {"type":"string","description":"End timecode 00:MM:SS"},
    "duration_seconds": {"type":"integer","minimum":1,"maximum":10},
    "elapsed_start_seconds": {"type":"integer","minimum":0,"maximum":200},
    "elapsed_end_seconds": {"type":"integer","minimum":1,"maximum":200},
    "narrative_function": {"type":"string"},
    "genre_state": {"type":"string"},
    "required_content": {"type":"string","description":"Required content per baseline §5"},
    "subject": {"type":"string"},
    "character_ids": {"type":"array","items":{"type":"string"}, "description":"Referenced character IDs — validator checks prohibited names"},
    "prop_ids": {"type":"array","items":{"type":"string","pattern":"^P_.*"}, "description":"Referenced props must be P_ prefixed"},
    "camera": {"type":"string"},
    "lens": {"type":"string"},
    "framing": {"type":"string"},
    "angle": {"type":"string"},
    "movement": {"type":"string"},
    "lighting": {"type":"string"},
    "blocking": {"type":"string"},
    "performance": {"type":"string","description":"Directional note; never invent biographical authority"},
    "dialogue": {"type":"string","description":"PROVISIONAL dialogue flagged; verbatim opening line preserved"},
    "sound": {"type":"string","description":"Sound design; T08/T09 enforce fourth-voice + first supernatural gates"},
    "editorial_transition_in": {"type":"string"},
    "editorial_transition_out": {"type":"string"},
    "continuity": {"type":"string"},
    "source_reference": {"type":"string"},
    "assumptions": {"type":"string","description":"Unknown info must be explicit — never convert assumption into capture metadata"},
    "verification_status": {"type":"string","enum":["PENDING — requires Phase 07 deterministic validation","VERIFIED","BLOCKED"]},
    "revisable": {"type":"boolean"},
    "original_state_preserved": {"type":"string"}
  },
  "additionalProperties": false
}
